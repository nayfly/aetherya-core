{
  "version": "v1",
  "kind": "procedural_evasions",
  "description": "Systematic evasion attempts against the ProceduralGuard rule corpus. Every case must be refused (allowed=false). `expect_hard_deny` marks cases where the destructive intent is unambiguous from the text alone; the rest are only resolvable at execution time (variable expansion, pipe contents) and are expected to reach the confirmation band instead.",
  "cases": [
    {
      "id": "evasion_quote_single_root_001",
      "category": "shell_quoting",
      "text": "rm -rf '/'",
      "expected": {
        "blocked": true,
        "hard_deny": true
      }
    },
    {
      "id": "evasion_quote_double_root_002",
      "category": "shell_quoting",
      "text": "rm -rf \"/\"",
      "expected": {
        "blocked": true,
        "hard_deny": true
      }
    },
    {
      "id": "evasion_quote_split_command_003",
      "category": "shell_quoting",
      "text": "r''m -rf /",
      "expected": {
        "blocked": true,
        "hard_deny": true
      }
    },
    {
      "id": "evasion_quote_split_path_004",
      "category": "shell_quoting",
      "text": "rm -rf /e''tc",
      "expected": {
        "blocked": true,
        "hard_deny": true
      }
    },
    {
